# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Required: Supabase ───────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The service role key bypasses row-level security. The server uses it to
# record orders, issue tickets and connect payout accounts. It must NEVER
# reach a browser — note it has no NEXT_PUBLIC_ prefix, which is what
# keeps Next.js from bundling it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Required in any real deployment ──────────────────────────
# Ticket links in emails are absolute, and a webhook has no request to
# infer a host from. Locally this can stay as-is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: payments ───────────────────────────────────────
# Leave BLANK to run in demo mode: checkout works end to end through
# /checkout/demo, orders settle through the same code path a real webhook
# uses, but no money moves and nothing talks to a processor.
# Setting this switches to the live gateway and disables demo checkout.
# PAYMENTS_PROVIDER_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ── Optional: email ──────────────────────────────────────────
# Leave BLANK and ticket emails are printed to the server console instead
# of being sent — including the ticket links, so you can follow them.
# EMAIL_PROVIDER_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=Paylance <tickets@yourdomain.com>
